# Mapbox (required for the map)
VITE_MAPBOX_TOKEN=pk.

# Firebase — optional; same project as Earth & Co: Project settings → Your apps → Web app → SDK snippet
# Add these domains under Authentication → Settings → Authorized domains: localhost, 127.0.0.1, your production host
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
